target/
dist/
__pycache__/
*.pyc

# Per-crate SBOMs are build outputs, regenerated by
# `cargo cyclonedx --manifest-path <crate>/Cargo.toml -f json --describe crate`
# and embedded into wheels by scripts/inject_sbom.py. They are not sources.
*.cdx.json

# Node-API binaries and tarballs are release outputs of scripts/build-node.sh
# and pnpm pack; index.js loads the binary by name, so they sit next to it.
*.node
*.tgz

# Repository doctors are source; local caches/build outputs are not.
# Local worktrees (e.g. a reviewer's scratch checkout) are working state,
# never part of a released tree.
/.worktrees/
/.leio-code/rust-doctors/target/
/.leio-code/index.json
/.leio-code/index-summary.json
/.leio-code/search.arrow
/.leio-code/events/
/.leio-code/exports/
/.leio-code/*.lock
